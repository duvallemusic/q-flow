# IBM Quantum Runtime credentials (prefer official local credential store).
# Do not commit real tokens.
#
# Recommended local layout (gitignored):
#   credentials/ibm_apikey.json  -> {"apikey":"..."}
#   credentials/ibm_crn.json     -> {"crn":"..."}  # optional
#
# Or environment variables:
# IBM_QUANTUM_TOKEN=your_token_here
# IBM_QUANTUM_INSTANCE=your_instance_crn_or_name
# QISKIT_IBM_TOKEN=your_token_here
# QISKIT_IBM_CHANNEL=ibm_quantum_platform
# QISKIT_IBM_INSTANCE=your_instance_crn_or_name
